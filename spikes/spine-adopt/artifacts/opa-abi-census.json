      "goStrictStdout": "{\n  \"errors\": [\n    {\n      \"message\": \"regex.match: error parsing regexp: invalid or unsupported Perl syntax: `(?!`\",\n      \"code\": \"eval_builtin_error\",\n      \"location\": {\n        \"file\": \"fo.rego\",\n        \"row\": 3,\n        \"col\": 11\n      }\n    }\n  ]\n}"
