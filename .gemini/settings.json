{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .gemini/hooks/SessionStart.cjs"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .gemini/hooks/BeforeTool.cjs"
          }
        ]
      }
    ]
  }
}
